POSTGRES_PASSWORD=CHANGE_ME
NODE_ENV=production
DATABASE_URL=postgresql://alumas:CHANGE_ME@db:5432/alumas
AUDIT_HASH_SALT=CHANGE_TO_LONG_RANDOM_VALUE
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=alumas-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SSE=AES256
CAPACITOR_SERVER_URL=https://app.alumas.com

# Maps
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# V13 automatic post-appointment review requests
CRON_SECRET=change-this-long-random-secret

# Video consultation provider: demo or daily
VIDEO_PROVIDER=demo
DAILY_API_KEY=

SECURITY_HASH_SALT=change-me-long-random-value

ALLOWED_ORIGINS=https://app.alumas.com

# v30 observability / ops
APP_ENV=production
METRICS_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
BACKUP_DIR=./backups

# v31 release candidate controls
APP_VERSION=0.32.0
BUILD_SHA=
RELEASE_CHANNEL=production
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_SECRET=
FEATURE_VIDEO_CONSULTATION=true
FEATURE_HEALTH_TOURISM=true
FEATURE_HOME_CARE=true
FEATURE_FAMILY_ACCESS=true
FEATURE_EMERGENCY_DIRECTORY=true
FEATURE_CAMPAIGNS=true
FEATURE_INSURANCE=true
FEATURE_HEALTH_INTEGRATIONS=true
FEATURE_ORGANIZATION_MARKETPLACE=true

# Google Maps Platform — server key for Places API (restrict by API/server)
GOOGLE_PLACES_API_KEY=
# Browser-restricted key for Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
