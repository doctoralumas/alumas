# Non-secret host deployment variables. Keep real secrets in /opt/alumas/staging/.env.staging (chmod 600).
RELEASE_CHANNEL=staging
APP_VERSION=0.34.0
BUILD_SHA=replace-with-git-sha
STAGING_DOMAIN=staging.example.com
STAGING_BASE_URL=https://staging.example.com
ALUMAS_IMAGE=ghcr.io/your-org/alumas@sha256:replace-with-real-digest
STAGING_ENABLE_PROXY=1
