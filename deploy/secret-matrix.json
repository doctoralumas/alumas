{
  "required_all": [
    "DATABASE_URL",
    "AUDIT_HASH_SALT",
    "SECURITY_HASH_SALT",
    "ALLOWED_ORIGINS",
    "APP_VERSION",
    "BUILD_SHA",
    "RELEASE_CHANNEL"
  ],
  "required_staging": [
    "POSTGRES_PASSWORD",
    "CRON_SECRET"
  ],
  "required_production": [
    "POSTGRES_PASSWORD",
    "METRICS_SECRET",
    "MAINTENANCE_BYPASS_SECRET",
    "CRON_SECRET"
  ],
  "conditional": {
    "SMS_PROVIDER=twilio": [
      "TWILIO_ACCOUNT_SID",
      "TWILIO_AUTH_TOKEN",
      "TWILIO_FROM"
    ],
    "STORAGE_DRIVER=s3": [
      "S3_ENDPOINT",
      "S3_BUCKET",
      "S3_ACCESS_KEY_ID",
      "S3_SECRET_ACCESS_KEY"
    ],
    "VIDEO_PROVIDER=daily": [
      "DAILY_API_KEY"
    ],
    "SENTRY_DSN set": [
      "SENTRY_DSN"
    ],
    "Firebase enabled": [
      "FIREBASE_PROJECT_ID",
      "FIREBASE_CLIENT_EMAIL",
      "FIREBASE_PRIVATE_KEY"
    ],
    "Google Places enabled": [
      "GOOGLE_PLACES_API_KEY",
      "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY"
    ]
  },
  "never_commit": [
    "TWILIO_AUTH_TOKEN",
    "FIREBASE_PRIVATE_KEY",
    "S3_SECRET_ACCESS_KEY",
    "DAILY_API_KEY",
    "METRICS_SECRET",
    "MAINTENANCE_BYPASS_SECRET",
    "CRON_SECRET",
    "GOOGLE_PLACES_API_KEY"
  ]
}