DATABASE_URL="postgresql://alumas:alumas@localhost:5432/alumas?schema=public"

# Native mobile shell: deployed HTTPS URL of the Alumas Next.js app.
# Example: https://app.alumas.com
CAPACITOR_SERVER_URL=

# Push delivery (server-side; optional until production credentials exist)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.alumas.health
APNS_PRIVATE_KEY=

# Maps / geocoding (optional in local demo)
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# V13 automatic post-appointment review requests
CRON_SECRET=change-this-long-random-secret

# Video consultation provider: demo or daily
VIDEO_PROVIDER=demo
DAILY_API_KEY=

SECURITY_HASH_SALT=change-me-long-random-value

ALLOWED_ORIGINS=https://app.alumas.com

# v30 observability / ops
APP_ENV=development
METRICS_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
BACKUP_DIR=./backups

# Google Maps Platform — server key for Places API (restrict by API/server)
GOOGLE_PLACES_API_KEY=
# Browser-restricted key for Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
