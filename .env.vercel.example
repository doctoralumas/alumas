# Core
DATABASE_URL=
APP_ENV=staging
NODE_ENV=production
APP_VERSION=0.42.0
BUILD_SHA=vercel
RELEASE_CHANNEL=staging
ALLOWED_ORIGINS=https://YOUR_PROJECT.vercel.app
SECURITY_HASH_SALT=
AUDIT_HASH_SALT=

# Required for persistent private uploads on Vercel
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SSE=AES256

# Google Places / Maps
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# SMS - optional until OTP/SMS is tested
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Push - optional
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Video - optional
VIDEO_PROVIDER=demo
DAILY_API_KEY=

# Ops
CRON_SECRET=
METRICS_SECRET=
MAINTENANCE_MODE=false
FEATURE_VIDEO_CONSULTATION=false
FEATURE_HEALTH_TOURISM=true
FEATURE_HOME_CARE=true
FEATURE_FAMILY_ACCESS=true
FEATURE_EMERGENCY_DIRECTORY=true
FEATURE_INSURANCE=true
FEATURE_ORGANIZATION_MARKETPLACE=true
