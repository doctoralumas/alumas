NODE_ENV=production
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://alumas:CHANGE_ME@db:5432/alumas_staging
AUDIT_HASH_SALT=CHANGE_TO_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=alumas-staging-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SSE=AES256
CAPACITOR_SERVER_URL=https://staging.alumas.com
ALUMAS_BASE_URL=https://staging.alumas.com

# V13 automatic post-appointment review requests
CRON_SECRET=change-this-long-random-secret

# Video consultation provider: demo or daily
VIDEO_PROVIDER=demo
DAILY_API_KEY=

SECURITY_HASH_SALT=change-me-long-random-value

ALLOWED_ORIGINS=https://staging.alumas.com

# v30 observability / ops
APP_ENV=staging
METRICS_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
BACKUP_DIR=./backups

STAGING_DOMAIN=staging.alumas.com
STAGING_BASE_URL=https://staging.alumas.com
STAGING_ENABLE_PROXY=1

APP_VERSION=0.33.0
BUILD_SHA=replace-with-git-sha
RELEASE_CHANNEL=staging
APP_URL=https://staging.alumas.com

# Google Maps Platform — server key for Places API (restrict by API/server)
GOOGLE_PLACES_API_KEY=
# Browser-restricted key for Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
